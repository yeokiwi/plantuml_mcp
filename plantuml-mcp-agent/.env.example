# ── DeepSeek LLM ──────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── MCP Server — PlantUML ──────────────────────────────────────────────────────
MCP_TRANSPORT=stdio           # "stdio" or "sse"
MCP_SSE_PORT=3001             # Only used when MCP_TRANSPORT=sse

# ── MCP Server — Code Parser ───────────────────────────────────────────────────
CODE_PARSER_TRANSPORT=stdio
CODE_PARSER_SSE_PORT=3002

# ── PlantUML Engine ────────────────────────────────────────────────────────────
PLANTUML_JAR_PATH=./plantuml/plantuml.jar
# Set to true to always use plantuml.com remote API instead of local JAR
PLANTUML_USE_REMOTE=false
PLANTUML_REMOTE_URL=https://www.plantuml.com/plantuml

# ── Code Parser ────────────────────────────────────────────────────────────────
# "regex" uses built-in regex parser (no .NET required)
# "roslyn" uses the Roslyn CLI (requires .NET SDK installed)
CSHARP_PARSER_STRATEGY=regex
DOTNET_PATH=/usr/bin/dotnet

# Maximum source file size to parse (in KB) — files larger than this are skipped
MAX_PARSE_FILE_SIZE_KB=512

# Maximum tokens to inject into LLM context from parsed symbol model
CODE_CONTEXT_MAX_TOKENS=8000

# Security: restrict which base directories the code parser can access.
# Comma-separated list of allowed path prefixes.
# Leave empty (or comment out) to allow all paths — fine for local development.
# Example for production: ALLOWED_BASE_PATHS=/home,/workspace,/projects
ALLOWED_BASE_PATHS=

# ── Backend Server ─────────────────────────────────────────────────────────────
PORT=3000
